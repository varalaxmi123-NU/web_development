PORT=4000

# --- Database: pick ONE ---
# Supabase: Project → Connect → "Session pooler" URI for local dev,
# or "Transaction pooler" (port 6543) on Vercel. URL-encode special characters (@ → %40).
# DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Local PostgreSQL / Docker (docker compose up -d db):
DATABASE_URL=postgres://teamflow:teamflow@localhost:5432/teamflow

JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- Optional: Supabase Realtime (instant push) + Storage (file uploads) ---
# Project Settings → API Keys. Without these, live updates sync every 2s and files go to UPLOAD_DIR.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
