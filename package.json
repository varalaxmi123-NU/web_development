{
  "name": "teamflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time collaborative project workspace (ALG-WEB-01)",
  "scripts": {
    "setup": "npm install && npm --prefix server install && npm --prefix client install",
    "db": "docker compose up -d db",
    "seed": "npm --prefix server run seed",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "test": "npm --prefix server test",
    "test:concurrency": "npm --prefix server run test:concurrency"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
